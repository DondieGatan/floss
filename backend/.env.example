# Copy to .env for local dev, or set these in your host's dashboard for deploys.
# Nothing here is required to run the app locally — every value has a dev-safe
# default in config.py — but GROQ_API_KEY is required for real chat answers,
# HF_TOKEN is required for document ingestion/retrieval to work at all (both
# call out to Hugging Face's Inference API — see app/ml.py), and the secrets
# below should be set explicitly in any shared/deployed environment.

SECRET_KEY=
JWT_SECRET_KEY=
GROQ_API_KEY=
HF_TOKEN=
DATABASE_URL=
# Comma-separated list of allowed frontend origins, e.g.:
# CORS_ORIGINS=https://floss-frontend.vercel.app
CORS_ORIGINS=
MAX_UPLOAD_MB=20
